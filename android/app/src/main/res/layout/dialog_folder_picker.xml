<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dark"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Выбор папки с игрой Far Cry"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Current Path Display -->
    <TextView
        android:id="@+id/tv_picker_current_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/card_bg"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        android:ellipsize="start"
        android:singleLine="true"
        android:textColor="@color/primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Status indicator in current folder -->
    <TextView
        android:id="@+id/tv_picker_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:paddingStart="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <!-- Folder List: Expands to fit available screen space -->
    <ListView
        android:id="@+id/lv_folder_items"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:divider="@color/card_stroke"
        android:dividerHeight="1dp" />

    <!-- Bottom Buttons: Always pinned to bottom, never pushed off-screen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_picker_cancel"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:minWidth="95dp"
            android:background="@drawable/btn_dark"
            android:text="@string/cancel"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_picker_select"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:minWidth="160dp"
            android:background="@drawable/btn_accent"
            android:text="Выбрать эту папку"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
