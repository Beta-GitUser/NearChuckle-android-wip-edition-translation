diff --git a/src/core/android/SDL_android.c b/src/core/android/SDL_android.c
index f9515a4..7e26641 100644
--- a/src/core/android/SDL_android.c
+++ b/src/core/android/SDL_android.c
@@ -916,6 +916,21 @@ JNIEXPORT void JNICALL SDL_JAVA_INTERFACE(nativeCleanupMainThread)(
     Android_JNI_SetEnv(NULL);
 }
 
+typedef struct {
+    int argc;
+    char **argv;
+    SDL_main_func SDL_main;
+    int status;
+} SDL_MainThreadContext;
+
+static void *Android_NativeMainThreadRunner(void *data)
+{
+    SDL_MainThreadContext *ctx = (SDL_MainThreadContext *)data;
+    Android_JNI_SetupThread();
+    ctx->status = SDL_RunApp(ctx->argc, ctx->argv, ctx->SDL_main, NULL);
+    return NULL;
+}
+
 // Start up the SDL app
 JNIEXPORT int JNICALL SDL_JAVA_INTERFACE(nativeRunMain)(JNIEnv *env, jclass cls, jstring library, jstring function, jobject array)
 {
@@ -992,8 +1007,26 @@ JNIEXPORT int JNICALL SDL_JAVA_INTERFACE(nativeRunMain)(JNIEnv *env, jclass cls,
                 }
                 argv[argc] = NULL;
 
-                // Run the application.
-                status = SDL_RunApp(argc, argv, SDL_main, NULL);
+                // Run the application on a dedicated 16MB pthread stack to avoid
+                // Android ART 1MB thread stack overflow in CryEngine 1 callgraphs.
+                SDL_MainThreadContext ctx;
+                ctx.argc = argc;
+                ctx.argv = argv;
+                ctx.SDL_main = SDL_main;
+                ctx.status = -1;
+
+                pthread_t th;
+                pthread_attr_t attr;
+                pthread_attr_init(&attr);
+                pthread_attr_setstacksize(&attr, 16 * 1024 * 1024);
+                if (pthread_create(&th, &attr, Android_NativeMainThreadRunner, &ctx) == 0) {
+                    pthread_join(th, NULL);
+                    status = ctx.status;
+                } else {
+                    __android_log_print(ANDROID_LOG_WARN, "SDL", "Failed to spawn 16MB stack thread, falling back");
+                    status = SDL_RunApp(argc, argv, SDL_main, NULL);
+                }
+                pthread_attr_destroy(&attr);
 
                 // Release the arguments.
                 free(args);  // This should NOT be SDL_free()
